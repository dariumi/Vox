#version 450
// Причинное внимание с GQA: блок на (голова, токен). Оценки лежат в shared-памяти (контекст ≤ 3072).
layout(local_size_x = 128) in;
layout(std430, set = 0, binding = 0) readonly buffer KB { float kc[]; };
layout(std430, set = 0, binding = 1) readonly buffer VB { float vc[]; };
layout(std430, set = 0, binding = 3) readonly buffer QB { float q[]; };
layout(std430, set = 0, binding = 4) writeonly buffer OB { float o[]; };
layout(push_constant) uniform PC { uint heads; uint kv_heads; uint hd; uint m; uint pos0; uint scale_bits; uint kd; uint row0; } pc;   // q / o rows row0 + i
shared float sc[3072];
shared float qv[128];
shared float red[128];
void main() {
    const uint h = gl_WorkGroupID.x, i = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    const uint n = pc.pos0 + i + 1u;
    const uint g = h / (pc.heads / pc.kv_heads);
    const float scale = uintBitsToFloat(pc.scale_bits);
    const uint qb = ((pc.row0 + i) * pc.heads + h) * pc.hd;
    for (uint e = t; e < pc.hd; e += 128u) qv[e] = q[qb + e];
    barrier();
    float mx = -3.0e38;
    for (uint j = t; j < n; j += 128u) {
        float s = 0.0;
        const uint kb = j * pc.kd + g * pc.hd;
        for (uint e = 0u; e < pc.hd; ++e) s += qv[e] * kc[kb + e];
        s *= scale;
        sc[j] = s;
        mx = max(mx, s);
    }
    red[t] = mx;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) { if (t < s) red[t] = max(red[t], red[t + s]); barrier(); }
    mx = red[0];
    barrier();
    float sum = 0.0;
    for (uint j = t; j < n; j += 128u) { float p = exp(sc[j] - mx); sc[j] = p; sum += p; }
    red[t] = sum;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
    const float inv = 1.0 / red[0];
    for (uint e = t; e < pc.hd; e += 128u) {
        float acc = 0.0;
        for (uint j = 0u; j < n; ++j) acc += sc[j] * vc[j * pc.kd + g * pc.hd + e];
        o[qb + e] = acc * inv;
    }
}

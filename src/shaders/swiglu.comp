#version 450
// Fused gate/up output [m][2I] → g [m][I] = silu(gate) * up.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 3) readonly buffer GU { float gu[]; };
layout(std430, set = 0, binding = 4) writeonly buffer GB { float g[]; };
layout(push_constant) uniform PC { uint m; uint I; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.m * pc.I) return;
    const uint row = i / pc.I, e = i - row * pc.I;
    const float a = gu[row * 2u * pc.I + e], u = gu[row * 2u * pc.I + pc.I + e];
    g[i] = (a / (1.0 + exp(-a))) * u;
}

#version 450
// Elementwise helpers of the F5-TTS DiT / Vocos on the GPU (index i = gl_GlobalInvocationID.x + 65535*256*y):
//   mode 0: y[i] += g[off + i % D] * x[i]                (gated residual: AdaLN gates, Vocos layer scale)
//   mode 1: y[i] = gelu_tanh(y[i])                       (DiT feed-forward)
//   mode 2: scatter x [N][D] into every sequence of y [S][N][off] at columns 0..D-1 (noisy mel into the input concat);
//           n = S*N*D
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer GB { float g[]; };
layout(std430, set = 0, binding = 3) readonly buffer XB { float x[]; };
layout(std430, set = 0, binding = 4) buffer YB { float y[]; };
layout(push_constant) uniform PC { uint n; uint D; uint mode; uint off; uint N; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 65535u * 256u;
    if (i >= pc.n) return;
    if (pc.mode == 0u) {
        y[i] += g[pc.off + i % pc.D] * x[i];
    } else if (pc.mode == 1u) {
        const float v = y[i];
        y[i] = 0.5 * v * (1.0 + tanh(0.7978845608028654 * (v + 0.044715 * v * v * v)));
    } else {
        const uint per = pc.N * pc.D, rem = i % per, sq = i / per, r = rem / pc.D, c = rem - r * pc.D;
        y[(sq * pc.N + r) * pc.off + c] = x[rem];
    }
}

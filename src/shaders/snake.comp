#version 450
// SnakeBeta: y = x + inv_b[c] * sin(x * a[c])^2, a = exp(alpha), inv_b = 1 / (exp(beta) + 1e-9) (precomputed on CPU).
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer PB { float p[]; };
layout(std430, set = 0, binding = 3) readonly buffer XB { float x[]; };
layout(std430, set = 0, binding = 4) writeonly buffer YB { float y[]; };
layout(push_constant) uniform PC { uint n; uint C; uint off_a; uint off_b; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 65535u * 256u;
    if (i >= pc.n) return;
    const uint c = i % pc.C;
    const float v = x[i], s = sin(v * p[pc.off_a + c]);
    y[i] = v + p[pc.off_b + c] * s * s;
}

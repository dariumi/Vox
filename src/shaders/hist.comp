#version 450
// Streaming history update: new = last ctx rows of [old (ctx rows); x (T rows)].
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 3) readonly buffer XB { float x[]; };
layout(std430, set = 0, binding = 4) writeonly buffer NB { float hnew[]; };
layout(std430, set = 0, binding = 5) readonly buffer OB { float hold[]; };
layout(push_constant) uniform PC { uint T; uint C; uint ctx; } pc;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.ctx * pc.C) return;
    const uint row = i / pc.C, c = i - row * pc.C, r = pc.T + row;
    hnew[i] = (r < pc.ctx) ? hold[r * pc.C + c] : x[(r - pc.ctx) * pc.C + c];
}
